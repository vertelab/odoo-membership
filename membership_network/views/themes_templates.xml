<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="membership_network_default_template">
        <style id="design-element">
            h2 {
                font-weight: bolder;
            }
            p, p > *, li, li > * {
                color: #6c757d;
            }
            a:not(.btn), a.btn.btn-link {
                font-weight: bolder;
            }
            hr {
                border-top-color: #ced4da !important;
            }
        </style>
        <div style="max-width: 600px; margin: 0 auto;">
            <div class="s_header_logo o_mail_block_header_logo o_mail_snippet_general pt16 pb16">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-4"/>
                        <div class="col-lg-4" style="text-align: center;">
                            <a t-att-href="(company_id.website) or '#'" style="text-decoration:none;" target="_blank">
                                <img border="0" t-att-src="company_logo" style="height:auto; max-width:100%;" width="180" class="img-fluid"/>
                            </a>
                        </div>
                        <div class="col-lg-4" style="text-align: right;"/>
                    </div>
                </div>
            </div>
            <div class="s_text_block o_mail_snippet_general pt40 pb16" style="padding-left: 15px; padding-right: 15px; margin-top: 20px;">
                <div class="container s_allow_columns">
                    <h2>You're invited to <t t-out="event_name"/>!</h2>
                    <p><br/>
                        Dear ${object.name},
                        <br/><br/>
                        You are invited to attend ${ref.name} <strong><t t-out="event_name"/></strong>.
                        As a valued member of <strong><t t-out="network_name"/></strong>,
                        we would love to see you there.
                    </p>
                    <p style="text-align: center;">
                        <a role="button" t-att-href="event_url" target="_blank" class="btn btn-primary">REGISTER NOW</a>
                    </p>
                </div>
            </div>
            <div class="s_hr pt16 pb16" data-snippet="s_hr" data-name="Separator">
                <hr class="s_hr_1px s_hr_solid"/>
            </div>
            <t t-call="mass_mailing.s_mail_block_footer_social_left"/>
        </div>
    </template>

    <record id="membership_network_default_template" model="ir.ui.view">
        <field name="mass_mailing_template" eval="True"/>
    </record>
</odoo>