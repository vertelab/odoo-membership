<odoo>
    <record id="base_view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.people.met</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_people_met"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-users"
                        invisible="people_met_count == 0">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="people_met_count" nolabel="1"/>
                        </span>
                        <span class="o_stat_text">People Met</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//group/group[//field[@name='vat']]" position="inside">
                <field name="network_ids" invisible="company_type == 'network'" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="view_partner_membership_network_inherit">
        <field name="name">res.partner.form.membership.network</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="membership.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='member_lines']//list//field[@name='membership_id']" position="after">
                <field name="network_id"/>
                <field name="state" widget="badge" 
                       decoration-info="state == 'waiting'" 
                       decoration-success="state in ['invoiced', 'free', 'paid']"
                       decoration-warning="state == 'old'"
                       decoration-danger="state == 'canceled'"/>
            </xpath>
            <xpath expr="//field[@name='member_lines']//list//field[@name='state']" position="after">
                <field name="associate_member_id"/>
            </xpath>
            <xpath expr="//field[@name='member_lines']//list//field[@name='account_invoice_id']" position="after">
                <field name="date_from"/>
                <field name="date_to"/>
            </xpath>
            <xpath expr="//field[@name='member_lines']//form//field[@name='membership_id']" position="after">
                <field name="network_id"/>
                <field name="state"/>
            </xpath>
            <xpath expr="//field[@name='member_lines']//form//field[@name='account_invoice_id']" position="after">
                <field name="date_from"/>
                <field name="date_to"/>
            </xpath>

            <xpath expr="//field[@name='associate_member']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='membership_start']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='membership_stop']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>