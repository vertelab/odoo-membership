<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_membership_network_list" model="ir.ui.view">
        <field name="name">membership.network.list</field>
        <field name="model">membership.network</field>
        <field name="arch" type="xml">
            <list string="Networks">
                <field name="name"/>
                <field name="product_ids"/>
                <field name="member_count"/>
                <field name="active_member_count"/>
            </list>
        </field>
    </record>

    <record id="view_membership_network_form" model="ir.ui.view">
        <field name="name">membership.network.form</field>
        <field name="model">membership.network</field>
        <field name="arch" type="xml">
            <form string="Network">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(membership.action_membership_members)d" type="action" class="oe_stat_button" icon="fa-users" context="{'search_default_membership_state': [('membership_state', 'in', ['invoiced', 'paid', 'free'])]}">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="active_member_count" nolabel="1"/>
                                </span>
                                <span class="o_stat_text">Active Members</span>
                            </div>
                        </button>
                        <button name="action_view_membership_lines" type="object" class="oe_stat_button" icon="fa-list">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Membership Lines</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="product_ids" widget="many2many_tags"/>
                            <field name="parent_id"/>
                        </group>
                        <group>
                            <field name="member_count"/>
                            <field name="network_partner_id"/>
                            <field name="invite_only"/>
                        </group>
                    </group>
  
                    <notebook>
                        <page string="Sub Networks" name="sub_networks">
                            <field name="child_ids">
                                <list string="Sub Networks" editable="bottom">
                                    <field name="name"/>
                                    <field name="product_ids"  widget="many2many_tags"/>
                                    <field name="member_count"/>
                                </list>
                            </field>
                        </page>
                        <page string="Members" name="members">
                            <field name="member_ids">
                                <list string="Members">
                                    <field name="name"/>
                                    <field name="email"/>
                                    <field name="phone"/>
                                    <field name="membership_state" widget="badge" 
                                           decoration-info="membership_state == 'waiting'" 
                                           decoration-success="membership_state in ['invoiced', 'free', 'paid']"
                                           decoration-warning="membership_state == 'old'"
                                           decoration-danger="membership_state == 'canceled'"/>
                                    <field name="membership_start"/>
                                    <field name="membership_stop"/>
                                </list>
                            </field>
                        </page>
                        <page string="Settings" name="settings">
                            <group>
                                <group string="Renewals &amp; Invoicing">
                                    <field name="send_invoices_automatically"/>
                                </group>
                                <group string="Notifications">
                                    <field name="days_before_expiration"/>
                                    <field name="mail_template_id"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_membership_network_kanban" model="ir.ui.view">
        <field name="name">membership.network.kanban</field>
        <field name="model">membership.network</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="product_ids"/>
                <field name="member_count"/>
                <field name="active_member_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_card_header">
                                <div class="o_kanban_card_header_title">
                                    <div class="o_primary"><field name="name"/></div>
                                    <div class="o_secondary"><field name="product_ids"/></div>
                                </div>
                            </div>
                            <div class="o_kanban_card_content">
                                <div class="o_kanban_card_manage_pane">
                                    <div>Total Members: <field name="member_count"/></div>
                                    <div>Active Members: <field name="active_member_count"/></div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_membership_network_search" model="ir.ui.view">
        <field name="name">membership.network.search</field>
        <field name="model">membership.network</field>
        <field name="arch" type="xml">
            <search string="Networks">
                <field name="name"/>
                <field name="product_ids"/>
            </search>
        </field>
    </record>

    <record id="action_membership_network" model="ir.actions.act_window">
        <field name="name">Networks</field>
        <field name="res_model">membership.network</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_membership_network_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new network
            </p>
            <p>
                Networks allow you to group members by linking to a membership product.
                Partners who purchase the network's membership product automatically become members.
            </p>
        </field>
    </record>

    <menuitem id="menu_membership_network"
              name="Networks"
              parent="membership.menu_association"
              action="action_membership_network"
              sequence="10"/>

    <record id="view_membership_line_search" model="ir.ui.view">
        <field name="name">membership.membership_line.search.network</field>
        <field name="model">membership.membership_line</field>
        <field name="arch" type="xml">
            <search string="Membership Lines">
                <field name="partner"/>
                <field name="membership_id"/>
                <field name="network_id"/>
                <field name="invoice_state"/>
                <group expand="0" string="Group By">
                    <filter string="Partner" name="partner" context="{'group_by': 'partner'}"/>
                    <filter string="Membership" name="membership" context="{'group_by': 'membership_id'}"/>
                    <filter string="Network" name="network" context="{'group_by': 'network_id'}"/>
                    <filter string="Membership Status" name="state" context="{'group_by': 'state'}"/>
                    <filter string="Invoice Status" name="invoice_state" context="{'group_by': 'invoice_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_membership_line_list" model="ir.ui.view">
        <field name="name">membership.membership_line.list.network</field>
        <field name="model">membership.membership_line</field>
        <field name="arch" type="xml">
            <list string="Membership Lines">
                <field name="partner"/>
                <field name="membership_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="state" string="Membership Status" widget="badge" 
                       decoration-info="state == 'waiting'" 
                       decoration-success="state in ['invoiced', 'paid', 'free']"
                       decoration-warning="state == 'old'"
                       decoration-danger="state == 'canceled'"/>
                <field name="invoice_state" widget="badge"
                       decoration-info="invoice_state == 'draft'"
                       decoration-success="invoice_state == 'posted'"
                       decoration-danger="invoice_state == 'cancel'"/>
                <field name="invoice_payment_state" widget="badge"
                       decoration-success="invoice_payment_state == 'paid'"
                       decoration-warning="invoice_payment_state in ['not_paid', 'partial']"/>
                <field name="network_id"/>
                <field name="account_invoice_id"/>
            </list>
        </field>
    </record>
</odoo>
