<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add session count to event sidebar -->
    <template id="event_session_count_sidebar" name="Event Session Count" inherit_id="website_event.event_description_full">
        <xpath expr="//div[@class='o_wevent_sidebar_block border-bottom pb-3 mb-4' and @itemprop='organizer']" position="after">
            <div t-if="event.event_table_ids and event.session_count" class="o_wevent_sidebar_block border-bottom pb-3 mb-4">
                <h6 class="o_wevent_sidebar_title">Table Sessions</h6>
                <div class="d-flex align-items-center">
                    <i class="fa fa-users me-2" title="Sessions"/>
                    <span>
                        <strong t-out="event.session_count"/> 
                        <t t-if="event.session_count == 1">Session</t>
                        <t t-else="">Sessions</t>
                    </span>
                </div>
                <small class="text-muted d-block mt-1">
                    You will be assigned to different tables for networking
                </small>
            </div>
        </xpath>
    </template>
</odoo>
