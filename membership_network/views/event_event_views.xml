<odoo>
    <data>
        <record model="ir.ui.view" id="event_event_booking_table_form">
            <field name="name">event booking table form</field>
            <field name="model">event.event</field>
            <field name="inherit_id" ref="event.view_event_form"/>
            <field name="arch" type="xml">
                <field name="tag_ids" position="after">
                    <field name="network_id"/>
                    <field name="event_table_ids" widget="many2many_tags"/>
                    <field name="session_count" invisible="not event_table_ids"/>
                </field>
                <field name="badge_format" position="before">
                    <field name="members_only"/>
                </field>

               <xpath expr="//button[last()]" position="after">
                    <button name="action_assign_tables"
                            class="btn btn-primary"
                            type="object"
                            string="Assign Tables (Bulk)"
                            invisible="not event_table_ids"
                            help="Intelligently assign tables for all sessions to all registrations"/>

                        <!-- <button name="action_finalize_registrations"
                            class="btn btn-primary"
                            type="object"
                            string="Finalize Registration"
                            help="Intelligently assign tables for all sessions to all registrations"/> -->
                </xpath>
            </field>
        </record>

        <record model="ir.ui.view" id="event_registration_booking_table_form">
            <field name="name">event registration booking table form</field>
            <field name="model">event.registration</field>
            <field name="inherit_id" ref="event.view_event_registration_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group/group[last()]" position="after">
                    <group string="Session Tables" name="session_tables" groups="base.group_no_one">
                        <field name="session_1_table_id"/>
                        <field name="session_2_table_id"/>
                        <field name="session_3_table_id"/>
                    </group>
                </xpath>
                <field name="date_closed" position="after">
                    <field name="network_name"/>
                </field>
            </field>
        </record>

        <record model="ir.ui.view" id="view_event_type_form">
            <field name="name">event type form</field>
            <field name="model">event.type</field>
            <field name="inherit_id" ref="event.view_event_type_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='tag_ids']" position="after">
                    <field name="event_table_ids" widget="many2many_tags"/>
                    <field name="network_id"/>
                    <field name="mass_mailing_template_id"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>