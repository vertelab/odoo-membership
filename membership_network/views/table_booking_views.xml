<odoo>
    <data>
        <record model="ir.ui.view" id="event_table_list">
            <field name="name">event table list</field>
            <field name="model">event.booking.table</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="capacity"/>
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="event_table_form">
            <field name="name">event table form</field>
            <field name="model">event.booking.table</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="capacity"/>
                            </group>
<!--                            <group></group>-->
                        </group>
                    </sheet>
                </form>
            </field>
        </record>


        <!-- actions opening views on models -->
        <record model="ir.actions.act_window" id="event_booking_table_action">
            <field name="name">Tables</field>
            <field name="res_model">event.booking.table</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem name="Event Tables" id="event_booking_table_menu" sequence="10" parent="event.menu_event_configuration" action="event_booking_table_action"/>

    </data>
</odoo>