<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="membership_products_form_rolling_inherit">
        <field name="name">membership.products.form.rolling.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="membership.membership_products_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='membership_details']/label[@for='membership_date_from']" position="before">
                <field name="is_rolling" widget="boolean_toggle"/>
                <label for="membership_duration" string="Duration" invisible="not is_rolling"/>
                <div class="o_row" invisible="not is_rolling">
                    <field name="membership_duration" required="is_rolling" nolabel="1"/>
                    <field name="membership_duration_unit" required="is_rolling" nolabel="1"/>
                </div>
            </xpath>
            <xpath expr="//label[@for='membership_date_from']" position="attributes">
                <attribute name="invisible">is_rolling</attribute>
            </xpath>
            <xpath expr="//div[hasclass('o_row')][field[@name='membership_date_from']]" position="attributes">
                <attribute name="invisible">is_rolling</attribute>
                <attribute name="required">not is_rolling</attribute>
            </xpath>
            <xpath expr="//div[hasclass('o_row')][field[@name='membership_date_from']]" position="after">
                <div class="alert alert-info" role="alert" invisible="is_rolling or not membership" colspan="2" style="margin-top: 10px;">
                    Note: For static memberships, remember to update the duration dates (From/To) before the current period expires to ensure continuous membership availability.
                </div>
            </xpath>
        </field>
    </record>
</odoo>
