<odoo>
    <data>
        <record id="action_server_join_network_membership" model="ir.actions.server">
            <field name="name">Join Network Membership</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="binding_model_id" ref="base.model_res_partner"/>
            <field name="binding_view_types">list,form</field>
            <field name="state">code</field>
            <field name="code">
action = records._server_action_join_membership()
if action:
    raise_action = action
            </field>
        </record>

        <record id="action_server_mark_attended" model="ir.actions.server">
            <field name="name">Mark as Attended</field>
            <field name="model_id" ref="event.model_event_registration"/>
            <field name="binding_model_id" ref="event.model_event_registration"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
        action = records.action_set_done()
            </field>
        </record>

        <record id="action_print_table_assignments_from_event" model="ir.actions.server">
            <field name="name">Print Table Assignment Labels</field>
            <field name="model_id" ref="event.model_event_event"/>
            <field name="binding_model_id" ref="event.model_event_event"/>
            <field name="binding_type">action</field>
            <field name="state">code</field>
            <field name="code">
# Get all registrations with partners and table assignments
registrations = records.registration_ids.filtered(lambda r: r.partner_id and (r.session_1_table_id or r.session_2_table_id or r.session_3_table_id))

if not registrations:
    raise UserError("No table assignments found for this event.")

# Call the report on registrations
action = env.ref('membership_network.event_table_assignment_glabel').report_action(registrations)
            </field>
        </record>

        <!-- Server Action for Renewing Expired Memberships -->
        <record id="action_server_renew_memberships" model="ir.actions.server">
            <field name="name">Renew Expired Memberships</field>
            <field name="model_id" ref="membership_network.model_membership_network"/>
            <field name="binding_model_id" ref="membership_network.model_membership_network"/>
            <field name="binding_view_types">list,form</field>
            <field name="state">code</field>
            <field name="code">
records.action_cron_renew_memberships()
            </field>
        </record>

        <!-- Server Action for Renewing Expired Memberships (on Membership Line) -->
        <record id="action_server_renew_membership_line" model="ir.actions.server">
            <field name="name">Renew Membership</field>
            <field name="model_id" ref="membership.model_membership_membership_line"/>
            <field name="binding_model_id" ref="membership.model_membership_membership_line"/>
            <field name="binding_view_types">list,form</field>
            <field name="state">code</field>
            <field name="code">
records.action_renew_membership()
            </field>
        </record>

        <!-- Server Action to Send Invoice (on Membership Line) -->
        <record id="action_server_send_invoice" model="ir.actions.server">
            <field name="name">Send Invoice</field>
            <field name="model_id" ref="membership.model_membership_membership_line"/>
            <field name="binding_model_id" ref="membership.model_membership_membership_line"/>
            <field name="binding_view_types">list,form</field>
            <field name="state">code</field>
            <field name="code">
records.action_send_invoice()
            </field>
        </record>

        <!-- Cron Job for Renewing Memberships -->
        <record id="ir_cron_renew_memberships" model="ir.cron">
            <field name="name">Membership: Renew Expired Memberships</field>
            <field name="model_id" ref="membership_network.model_membership_network"/>
            <field name="state">code</field>
            <field name="code">model.action_cron_renew_memberships()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>

        <!-- Cron Job for Expiration Reminders -->
        <record id="ir_cron_membership_expiration_reminder" model="ir.cron">
            <field name="name">Membership: Send Expiration Reminders</field>
            <field name="model_id" ref="membership.model_membership_membership_line"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_expiration_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>

    </data>
</odoo>